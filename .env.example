# Copy to .env.local. Never commit real values.
# Each phase in docs/phases/ lists the variables it adds.

# Canonical origin. Optional on Vercel: production falls back to the project's
# production domain (VERCEL_PROJECT_PRODUCTION_URL), previews to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Umami Cloud analytics (M4-T6). Leave the ID empty to disable tracking.
# Only loaded in production builds, never on Vercel previews.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# AI assistant (M6). Without a provider /api/chat answers 503 and the
# launcher stays hidden; production also needs Upstash (rate limits).
#
# AI_PROVIDER picks the API: "openai" (OpenAI Chat Completions — official
# OpenAI or any compatible gateway) or "anthropic" (Anthropic Messages).
# Keep both sets filled and flip AI_PROVIDER to switch; redeploy after.
AI_PROVIDER=

# Method 1 — third-party gateway (OpenAI-compatible):
#   AI_PROVIDER=openai, OPENAI_BASE_URL=https://api.vilao.ai/v1,
#   OPENAI_MODEL=occ/claude-sonnet-5
# Method 2a — official OpenAI: leave OPENAI_BASE_URL empty.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Method 2b — official Anthropic (AI_PROVIDER=anthropic). ANTHROPIC_BASE_URL
# only for an Anthropic-compatible proxy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Supabase stores questions for 30 days (supabase/migrations). Optional.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Vercel Cron sends it to /api/cron/keepalive (at least 16 characters).
CRON_SECRET=
# Canned chat answers for tests and CI; ignored in production.
CHAT_MOCK=
